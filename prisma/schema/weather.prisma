model Weather {
  id         String   @id @default(uuid()) @db.Uuid
  lat        Float
  lon        Float
  location   String
  weather    String
  temp       Float
  pressure   Int
  humidity   Int
  windSpeed  Float    @map("wind_speed")
  windDegree Int      @map("wind_degree")
  sunrise    Int
  sunset     Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([lat, lon])
  @@map("weather")
}